# Sanity admin panel (create a project at https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the Sanity → /api/revalidate webhook (any long random string)
SANITY_REVALIDATE_SECRET=

# Optional: only needed if the dataset is private
SANITY_API_READ_TOKEN=
